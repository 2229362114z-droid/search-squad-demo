{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "displayName",
          "description",
          "artId",
          "price",
          "width",
          "height",
          "maxStack",
          "effect",
          "maxCarry"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "displayName": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "artId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "price": {
            "type": "integer",
            "minimum": 0
          },
          "width": {
            "const": 1
          },
          "height": {
            "const": 1
          },
          "maxStack": {
            "type": "integer",
            "minimum": 1
          },
          "effect": {
            "type": "object",
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "enum": [
                  "heal_team",
                  "revive_member",
                  "reduce_terror",
                  "next_combat_boost",
                  "unlock_chest",
                  "reroll_event_die",
                  "next_combat_off_nature"
                ]
              },
              "amount": {
                "type": "number",
                "minimum": 0
              },
              "healthRatio": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "damageRatio": {
                "type": "number",
                "minimum": 0
              },
              "reductionRatio": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              },
              "featureRatio": {
                "type": "number",
                "minimum": 0,
                "maximum": 1
              }
            }
          },
          "maxCarry": {
            "type": "integer",
            "minimum": 1
          },
          "availableInPreparation": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
