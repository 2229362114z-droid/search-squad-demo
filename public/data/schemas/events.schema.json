{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "triggerChance",
    "dc",
    "difficulties",
    "failureHealthRatio",
    "healAmount",
    "energyRatio",
    "terrorReduction",
    "supplyFallbackCoins",
    "boost",
    "items"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "triggerChance": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "dc": {
      "type": "integer",
      "minimum": 3,
      "maximum": 18
    },
    "difficulties": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "displayName",
          "dcOffset",
          "weight",
          "rewardMultiplier",
          "merchantCoins"
        ],
        "properties": {
          "id": {
            "enum": ["normal", "advanced", "hard"]
          },
          "displayName": {
            "type": "string",
            "minLength": 1
          },
          "dcOffset": {
            "type": "integer",
            "minimum": -5,
            "maximum": 5
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "rewardMultiplier": {
            "type": "integer",
            "minimum": 1,
            "maximum": 2
          },
          "merchantCoins": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "failureHealthRatio": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "healAmount": {
      "type": "integer",
      "minimum": 1
    },
    "energyRatio": {
      "type": "number",
      "exclusiveMinimum": 0,
      "maximum": 1
    },
    "terrorReduction": {
      "type": "integer",
      "minimum": 1
    },
    "supplyFallbackCoins": {
      "type": "integer",
      "minimum": 0
    },
    "boost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["battles", "damageRatio", "reductionRatio"],
      "properties": {
        "battles": {
          "type": "integer",
          "minimum": 1
        },
        "damageRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reductionRatio": {
          "type": "number",
          "minimum": 0,
          "maximum": 0.9
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "weight", "physical", "ghost"],
        "properties": {
          "id": {
            "enum": [
              "merchant",
              "healing",
              "boost",
              "energy",
              "calm",
              "supplies"
            ]
          },
          "weight": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "physical": {
            "$ref": "#/definitions/story"
          },
          "ghost": {
            "$ref": "#/definitions/story"
          }
        }
      }
    }
  },
  "definitions": {
    "story": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "description"],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
