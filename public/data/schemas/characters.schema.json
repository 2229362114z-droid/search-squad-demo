{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "movementSpeed", "characters"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "movementSpeed": { "type": "number", "exclusiveMinimum": 0 },
    "characters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "displayName",
          "role",
          "artId",
          "maxHealth",
          "attack",
          "attackIntervalMs",
          "baseAggro",
          "energyOnAttackHit",
          "energyOnDamageTaken",
          "ultimate"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "displayName": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "artId": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "maxHealth": { "type": "integer", "minimum": 1 },
          "attack": { "type": "number", "minimum": 0 },
          "attackIntervalMs": { "type": "integer", "minimum": 1 },
          "baseAggro": { "type": "number", "minimum": 0 },
          "energyOnAttackHit": { "type": "number", "exclusiveMinimum": 0 },
          "energyOnDamageTaken": { "type": "number", "exclusiveMinimum": 0 },
          "ultimate": {
            "oneOf": [
              { "$ref": "#/definitions/highestThreatBarrage" },
              { "$ref": "#/definitions/tauntAndReduceDamage" },
              { "$ref": "#/definitions/allEnemyDamageAndStun" },
              { "$ref": "#/definitions/teamShield" }
            ]
          }
        }
      }
    }
  },
  "definitions": {
    "highestThreatBarrage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "hitCount", "damageRatioPerHit"],
      "properties": {
        "type": { "const": "highest_threat_barrage" },
        "hitCount": { "type": "integer", "minimum": 1 },
        "damageRatioPerHit": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "tauntAndReduceDamage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "durationMs",
        "aggroMultiplier",
        "damageReductionRatio"
      ],
      "properties": {
        "type": { "const": "taunt_and_reduce_damage" },
        "durationMs": { "type": "integer", "minimum": 1 },
        "aggroMultiplier": { "type": "number", "minimum": 1 },
        "damageReductionRatio": {
          "type": "number",
          "minimum": 0,
          "exclusiveMaximum": 1
        }
      }
    },
    "allEnemyDamageAndStun": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "damageRatio", "stunDurationMs"],
      "properties": {
        "type": { "const": "all_enemy_damage_and_stun" },
        "damageRatio": { "type": "number", "exclusiveMinimum": 0 },
        "stunDurationMs": { "type": "integer", "minimum": 1 }
      }
    },
    "teamShield": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "shieldAmount", "durationMs"],
      "properties": {
        "type": { "const": "team_shield" },
        "shieldAmount": { "type": "number", "exclusiveMinimum": 0 },
        "durationMs": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
