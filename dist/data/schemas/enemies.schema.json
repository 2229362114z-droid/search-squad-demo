{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "enemies"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "enemies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "displayName",
          "artId",
          "tier",
          "maxHealth",
          "attack",
          "attackIntervalMs",
          "baseThreat",
          "frontlineOrder",
          "spawnWeight",
          "nature"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "displayName": {
            "type": "string",
            "minLength": 1
          },
          "artId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "tier": {
            "enum": ["standard", "elite", "boss"]
          },
          "maxHealth": {
            "type": "integer",
            "minimum": 1
          },
          "attack": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "attackIntervalMs": {
            "type": "integer",
            "minimum": 1
          },
          "baseThreat": {
            "type": "number",
            "minimum": 0
          },
          "frontlineOrder": {
            "type": "integer",
            "minimum": 0
          },
          "spawnWeight": {
            "type": "integer",
            "minimum": 1
          },
          "nature": {
            "enum": ["physical", "ghost"]
          }
        }
      }
    }
  }
}
