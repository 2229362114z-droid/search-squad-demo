{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "autoSearcherCount",
    "minimumApproachDurationMs",
    "targetAverageRewardsPerPoint",
    "rewardCountWeights",
    "qualities",
    "rewards",
    "roomRules"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "autoSearcherCount": { "type": "integer", "minimum": 1, "maximum": 3 },
    "minimumApproachDurationMs": { "type": "integer", "minimum": 1 },
    "targetAverageRewardsPerPoint": {
      "type": "number",
      "minimum": 1,
      "maximum": 4
    },
    "rewardCountWeights": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["count", "weight"],
        "properties": {
          "count": { "type": "integer", "minimum": 1, "maximum": 4 },
          "weight": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "qualities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "displayName", "durationMs", "color"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "displayName": { "type": "string", "minLength": 1 },
          "durationMs": { "type": "integer", "minimum": 1 },
          "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
        }
      }
    },
    "rewards": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "displayName",
          "description",
          "artId",
          "qualityId",
          "value",
          "width",
          "height",
          "maxStack"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "displayName": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 },
          "artId": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "qualityId": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
          "value": { "type": "integer", "minimum": 0 },
          "width": { "const": 1 },
          "height": { "const": 1 },
          "maxStack": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "roomRules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["combat", "elite", "treasure", "boss"],
      "properties": {
        "combat": { "$ref": "#/definitions/roomRule" },
        "elite": { "$ref": "#/definitions/roomRule" },
        "treasure": { "$ref": "#/definitions/roomRule" },
        "boss": { "$ref": "#/definitions/roomRule" }
      }
    }
  },
  "definitions": {
    "roomRule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimumPoints",
        "maximumPoints",
        "minimumLockedPoints",
        "lockedRoomChance",
        "qualityWeights"
      ],
      "properties": {
        "minimumPoints": { "type": "integer", "minimum": 1, "maximum": 4 },
        "maximumPoints": { "type": "integer", "minimum": 1, "maximum": 4 },
        "minimumLockedPoints": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4
        },
        "lockedRoomChance": { "type": "number", "minimum": 0, "maximum": 1 },
        "qualityWeights": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["qualityId", "weight"],
            "properties": {
              "qualityId": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$" },
              "weight": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    }
  }
}
