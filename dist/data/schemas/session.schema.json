{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "baselineWidth", "baselineHeight", "sceneHeight", "extractionDurationMs", "prototypeCombatDurationMs", "backgroundClockPaused"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "baselineWidth": { "type": "integer", "minimum": 1 },
    "baselineHeight": { "type": "integer", "minimum": 1 },
    "sceneHeight": { "type": "integer", "minimum": 1 },
    "extractionDurationMs": { "type": "integer", "minimum": 0 },
    "prototypeCombatDurationMs": { "type": "integer", "minimum": 0 },
    "backgroundClockPaused": { "type": "boolean" }
  }
}
