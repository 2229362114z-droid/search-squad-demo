{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "initialCoins",
    "failureSafetyThreshold",
    "failureSafetyGrant",
    "refreshDuringRunIsFailure",
    "growth"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "initialCoins": {
      "type": "integer",
      "minimum": 0
    },
    "failureSafetyThreshold": {
      "type": "integer",
      "minimum": 0
    },
    "failureSafetyGrant": {
      "type": "integer",
      "minimum": 0
    },
    "refreshDuringRunIsFailure": {
      "const": true
    },
    "growth": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "effectPerLevel",
        "upgradeCosts",
        "foresightUpgradeCosts"
      ],
      "properties": {
        "effectPerLevel": {
          "const": 0.02
        },
        "upgradeCosts": {
          "type": "array",
          "minItems": 10,
          "maxItems": 10,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "foresightUpgradeCosts": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    }
  }
}
