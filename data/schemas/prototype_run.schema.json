{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "startRoomId",
    "maximumTreasureClusterSize",
    "mapLayout",
    "dangerRules",
    "expectedRoomCounts",
    "mapGeneration"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "startRoomId": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "maximumTreasureClusterSize": {
      "const": 2
    },
    "mapLayout": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "worldWidth",
        "worldHeight",
        "roomNodeSize",
        "roadStrokeWidth",
        "minimumScale",
        "maximumScale",
        "defaultScale",
        "panGutter",
        "centerToRoadRatio"
      ],
      "properties": {
        "worldWidth": {
          "type": "integer",
          "minimum": 320,
          "maximum": 4096
        },
        "worldHeight": {
          "type": "integer",
          "minimum": 240,
          "maximum": 4096
        },
        "roomNodeSize": {
          "type": "integer",
          "minimum": 24,
          "maximum": 160
        },
        "roadStrokeWidth": {
          "type": "number",
          "minimum": 1,
          "maximum": 12
        },
        "minimumScale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 4
        },
        "maximumScale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 4
        },
        "defaultScale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 4
        },
        "panGutter": {
          "type": "integer",
          "minimum": 0,
          "maximum": 240
        },
        "centerToRoadRatio": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum", "maximum"],
          "properties": {
            "minimum": {
              "type": "number",
              "minimum": 1.1,
              "maximum": 10
            },
            "maximum": {
              "type": "number",
              "minimum": 1.1,
              "maximum": 10
            }
          }
        }
      }
    },
    "dangerRules": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roomsPerLevel", "maximumDanger", "bossDanger"],
      "properties": {
        "roomsPerLevel": {
          "type": "integer",
          "minimum": 1
        },
        "maximumDanger": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        },
        "bossDanger": {
          "type": "integer",
          "minimum": 1,
          "maximum": 7
        }
      }
    },
    "expectedRoomCounts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["start", "combat", "elite", "treasure", "boss", "merchant"],
      "properties": {
        "start": {
          "const": 1
        },
        "combat": {
          "const": 73
        },
        "elite": {
          "const": 12
        },
        "treasure": {
          "const": 24
        },
        "boss": {
          "const": 4
        },
        "merchant": {
          "const": 6
        }
      }
    },
    "mapGeneration": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "grid",
        "startColumn",
        "startRow",
        "averageDegree",
        "minimumFarthestDistance",
        "minimumBossDistance",
        "minimumBossSeparation",
        "minimumEliteDistance",
        "minimumNatureEliteCount",
        "maximumNatureCombatGap",
        "maximumAttempts",
        "roomNames"
      ],
      "properties": {
        "grid": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "columns",
            "rows",
            "originX",
            "originY",
            "stepX",
            "stepY"
          ],
          "properties": {
            "columns": {
              "type": "integer",
              "minimum": 3,
              "maximum": 64
            },
            "rows": {
              "type": "integer",
              "minimum": 3,
              "maximum": 64
            },
            "originX": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "originY": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "stepX": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100
            },
            "stepY": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100
            }
          }
        },
        "startColumn": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63
        },
        "startRow": {
          "type": "integer",
          "minimum": 0,
          "maximum": 63
        },
        "averageDegree": {
          "type": "object",
          "additionalProperties": false,
          "required": ["minimum", "maximum"],
          "properties": {
            "minimum": {
              "type": "number",
              "minimum": 1,
              "maximum": 4
            },
            "maximum": {
              "type": "number",
              "minimum": 1,
              "maximum": 4
            }
          }
        },
        "minimumFarthestDistance": {
          "type": "integer",
          "minimum": 1
        },
        "minimumBossDistance": {
          "type": "integer",
          "minimum": 1
        },
        "minimumBossSeparation": {
          "type": "integer",
          "minimum": 0
        },
        "minimumEliteDistance": {
          "type": "integer",
          "minimum": 0
        },
        "minimumNatureEliteCount": {
          "type": "integer",
          "minimum": 0
        },
        "maximumNatureCombatGap": {
          "type": "integer",
          "minimum": 0
        },
        "maximumAttempts": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "roomNames": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "start",
            "combat",
            "elite",
            "treasure",
            "boss",
            "merchant"
          ],
          "properties": {
            "start": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "combat": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "elite": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "treasure": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "boss": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "merchant": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    }
  }
}
