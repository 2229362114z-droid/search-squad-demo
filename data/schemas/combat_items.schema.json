{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "dropChanceByRoomKind", "items"],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "dropChanceByRoomKind": {
      "type": "object",
      "additionalProperties": false,
      "required": ["combat", "elite", "treasure", "boss"],
      "properties": {
        "combat": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "elite": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "treasure": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "boss": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "displayName",
          "description",
          "artId",
          "qualityId",
          "value",
          "width",
          "height",
          "maxStack",
          "dropWeight",
          "effect",
          "nature",
          "baseDamageRatio",
          "baseReductionRatio"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "displayName": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "artId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "qualityId": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "value": {
            "const": 0
          },
          "width": {
            "const": 1
          },
          "height": {
            "const": 1
          },
          "maxStack": {
            "const": 1
          },
          "dropWeight": {
            "type": "integer",
            "minimum": 1
          },
          "effect": {
            "oneOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "ratio"],
                "properties": {
                  "type": {
                    "enum": [
                      "basic_damage",
                      "attack_speed",
                      "lifesteal",
                      "energy_gain",
                      "damage_reduction",
                      "shield_power"
                    ]
                  },
                  "ratio": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 6
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "amount", "durationMs"],
                "properties": {
                  "type": {
                    "const": "ultimate_shield"
                  },
                  "amount": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "durationMs": {
                    "type": "integer",
                    "minimum": 100
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["type", "ratio", "stunBonusMs"],
                "properties": {
                  "type": {
                    "const": "ultimate_power"
                  },
                  "ratio": {
                    "type": "number",
                    "exclusiveMinimum": 0,
                    "maximum": 20
                  },
                  "stunBonusMs": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 2000
                  }
                }
              }
            ]
          },
          "nature": {
            "enum": ["physical", "ghost"]
          },
          "baseDamageRatio": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "baseReductionRatio": {
            "type": "number",
            "minimum": 0,
            "maximum": 0.16
          },
          "targetCharacterId": {
            "enum": ["shen_yan", "hong_wu", "xuan_zhen", "su_ling"]
          }
        }
      }
    }
  }
}
